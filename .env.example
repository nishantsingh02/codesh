# Configure only the provider keys you use.
# Built-in providers: openrouter, openai, anthropic, deepseek, glm
# Custom providers: see ~/.codesh/providers.json
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GLM_API_KEY=

# Optional: override the default model, app name, or site URL
# OPENROUTER_MODEL=anthropic/claude-sonnet-4-6
# OPENROUTER_APP_NAME=Codesh
# OPENROUTER_SITE_URL=http://localhost

# Optional: title generation model (defaults to openai/gpt-4o-mini)
# OPENROUTER_TITLE_MODEL=openai/gpt-4o-mini

# Optional: terminal layout override
# CODESH_LAYOUT=classic
# CODESH_THEME=gruvbox

# Optional: cap output tokens per turn (default 8192).
# Useful on low OpenRouter balances, where the request is rejected with 402
# if max_tokens exceeds what your remaining credits can afford.
# CODESH_MAX_OUTPUT_TOKENS=1500
